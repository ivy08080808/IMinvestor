# Copy to .env and adjust. Values below are LOCAL DEVELOPMENT test values only.

# PostgreSQL (role/database created per README "安裝")
DATABASE_URL=postgresql://iminvestor:iminvestor_dev@localhost:5432/iminvestor

# MongoDB (behavior logs). If unreachable, logging is skipped and the app still runs.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=iminvestor

# JWT signing secret for local development. Use a long random string in any shared deployment.
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 0 to disable the 15:00 scheduler (e.g. when running several backend copies)
SCHEDULER_ENABLED=1

# Default admin created by scripts/init_db.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@iminvestor.local
ADMIN_PASSWORD=admin1234
